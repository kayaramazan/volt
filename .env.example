# Backend env (dev). Copy to BOTH of these (Prisma reads .env from the
# package it runs in, there is no shared loader):
#   cp .env.example packages/db/.env     # prisma migrate / generate / seed
#   cp .env.example apps/backend/.env    # backend runtime
DATABASE_URL=postgresql://volt:volt_dev_password@localhost:5432/volt?schema=public
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars
PORT=4000
NODE_ENV=development

# CORS — desktop in dev uses Vite at localhost:5173; production uses app:// protocol
CORS_ORIGINS=http://localhost:5173

# Billing (optional — billing endpoints stay disabled without STRIPE_SECRET_KEY)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
# APP_URL=http://localhost:5173

# Desktop: override the sync API base URL (defaults to http://localhost:4000 in dev)
# VITE_API_URL=http://localhost:4000
