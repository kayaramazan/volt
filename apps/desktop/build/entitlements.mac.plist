<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for Electron apps to run on macOS with hardened runtime -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Network access for HTTP requests -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- File access for import/export -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Shared container with the widget extension (native/VoltWidget) -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>2WPVK976M4.dev.volt.shared</string>
    </array>
</dict>
</plist>
