{
  "name": "volt",
  "version": "0.1.0",
  "private": true,
  "description": "Volt — fast, local-first API client",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:desktop": "pnpm --filter @volt/desktop dev",
    "dev:backend": "pnpm --filter @volt/backend dev",
    "build": "turbo run build",
    "build:desktop": "pnpm --filter @volt/desktop build",
    "build:backend": "pnpm --filter @volt/backend build",
    "build:cli": "pnpm --filter @volt/cli build",
    "volt": "pnpm --filter @volt/cli dev --",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate:backend": "pnpm --filter @volt/db migrate:dev",
    "db:generate:backend": "pnpm --filter @volt/db generate",
    "db:seed:backend": "pnpm --filter @volt/db seed",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.6.0",
    "prettier": "^3.3.3",
    "@types/node": "^22.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
